create table web_visit_summary
(
    summary_id     bigint auto_increment comment '汇总ID'
        primary key,
    web_id         varchar(50)                             not null comment '网站ID',
    stats_date     date                                    not null comment '统计日期',
    total_visits   int           default 0                 null comment '总访问量',
    unique_users   int           default 0                 null comment '独立访客数',
    total_duration int           default 0                 null comment '总停留时长(秒)',
    avg_duration   int           default 0                 null comment '平均停留时长(秒)',
    bounce_rate    decimal(5, 2) default 0.00              null comment '跳出率(%)',
    create_time    datetime      default CURRENT_TIMESTAMP null comment '创建时间',
    update_time    datetime      default CURRENT_TIMESTAMP null on update CURRENT_TIMESTAMP comment '更新时间',
    constraint uk_web_date
        unique (web_id, stats_date)
)
    comment '网站访问汇总统计表' charset = utf8mb4;

create index idx_stats_date
    on web_visit_summary (stats_date);


create table web_image_position
(
    position_id   bigint auto_increment comment '位置ID'
        primary key,
    web_id        varchar(50)                          not null comment '网站ID',
    position_code varchar(100)                         not null comment '位置编码',
    position_name varchar(200)                         not null comment '位置名称',
    file_id       bigint                               null comment '关联的文件ID',
    image_url     varchar(500)                         null comment '图片URL',
    image_desc    varchar(500)                         null comment '图片描述',
    sort_order    int        default 0                 null comment '排序',
    status        tinyint(1) default 1                 null comment '状态(0禁用 1启用)',
    create_time   datetime   default CURRENT_TIMESTAMP null comment '创建时间',
    create_user   bigint                               null comment '创建人',
    update_time   datetime   default CURRENT_TIMESTAMP null on update CURRENT_TIMESTAMP comment '更新时间',
    update_user   bigint                               null comment '更新人',
    del_flag      tinyint(1) default 0                 null comment '删除标志(0正常 1删除)',
    constraint uk_web_position
        unique (web_id, position_code, del_flag)
)
    comment '网站图片位置表' charset = utf8mb4;

create index idx_create_time
    on web_image_position (create_time);

create index idx_file_id
    on web_image_position (file_id);

create index idx_position_code
    on web_image_position (position_code);

create index idx_status
    on web_image_position (status);

create index idx_web_id
    on web_image_position (web_id);


create table user_daily_stats
(
    stats_id       bigint auto_increment comment '统计ID'
        primary key,
    user_id        bigint                             null comment '用户ID',
    web_id         varchar(50)                        not null comment '网站ID',
    stats_date     date                               not null comment '统计日期',
    visit_count    int      default 0                 null comment '访问次数',
    total_duration int      default 0                 null comment '总停留时长(秒)',
    avg_duration   int      default 0                 null comment '平均停留时长(秒)',
    page_count     int      default 0                 null comment '访问页面数',
    create_time    datetime default CURRENT_TIMESTAMP null comment '创建时间',
    update_time    datetime default CURRENT_TIMESTAMP null on update CURRENT_TIMESTAMP comment '更新时间',
    constraint idx_user_daily_stats_web_date
        unique (web_id, stats_date),
    constraint uk_user_web_date
        unique (user_id, web_id, stats_date)
)
    comment '用户每日统计表' charset = utf8mb4;

create index idx_stats_date
    on user_daily_stats (stats_date);

create index idx_user_id
    on user_daily_stats (user_id);


create table user_visit_record
(
    visit_id    bigint auto_increment comment '访问记录ID'
        primary key,
    user_id     bigint                             null comment '用户ID',
    web_id      varchar(50)                        not null comment '网站ID',
    page_url    varchar(500)                       null comment '页面URL',
    page_title  varchar(200)                       null comment '页面标题',
    visit_time  datetime default CURRENT_TIMESTAMP not null comment '访问时间',
    leave_time  datetime                           null comment '离开时间',
    duration    int      default 0                 null comment '停留时长(秒)',
    ip_address  varchar(50)                        null comment 'IP地址',
    user_agent  varchar(500)                       null comment '用户代理',
    device_type varchar(20)                        null comment '设备类型',
    browser     varchar(50)                        null comment '浏览器',
    create_time datetime default CURRENT_TIMESTAMP null comment '创建时间'
)
    comment '用户访问记录表' charset = utf8mb4;

create index idx_duration
    on user_visit_record (duration);

create index idx_user_id
    on user_visit_record (user_id);

create index idx_visit_time
    on user_visit_record (visit_time);

create index idx_web_id
    on user_visit_record (web_id);

